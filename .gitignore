# Local session / tooling state — not shared project content
.claude/

# Environment variables / secrets — never committed
.env
.env.*
# ...except the committed template documenting which variables are needed
!.env.example

# LibreOffice lock files
.~lock.*#

# Maven build output (module-level .gitignore already covers this, kept here as a root-level catch-all)
target/

# OS/editor cruft
.DS_Store
.idea/
.vscode/
*.iml
