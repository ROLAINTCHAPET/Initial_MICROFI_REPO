# Template for .env — copy to .env and fill in real values. .env itself is git-ignored.

# Postgres (shared by postgres, microfi-core, microfi-middleware)
DB_USER=microfi
DB_PASSWORD=changeme
DB_NAME=microfi

# RabbitMQ (shared by rabbitmq, microfi-core)
RABBITMQ_USER=microfi
RABBITMQ_PASSWORD=changeme

# First ADMIN account, bootstrapped once at microfi-core startup (AdminBootstrapRunner).
# Change these before any real deployment.
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme

# UC-09/FR-09 SMS gateway — leave unset to have sends fail gracefully (logged as FAILED).
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SENDER_ADDRESS=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
